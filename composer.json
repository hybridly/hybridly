{
    "name": "hybridly/hybridly",
    "authors": [
        {
            "name": "Enzo Innocenzi",
            "email": "enzo@innocenzi.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.1",
        "illuminate/contracts": "^12.0|^13.0",
        "laravel/prompts": "^0.1|^0.2|^0.3",
        "spatie/php-structure-discoverer": "^2.0"
    },
    "require-dev": {
        "carthage-software/mago": "^0.24.5",
        "guzzlehttp/promises": "^2.3.0",
        "laravel/octane": "^2.13.5",
        "nunomaduro/collision": "^8.8.3",
        "orchestra/testbench": "^10.9|^11.0",
        "pestphp/pest": "^4.3.2",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-data": "^4.19.1",
        "spatie/laravel-ray": "^1.43.5",
        "spatie/laravel-typescript-transformer": "^2.5.2",
        "symplify/monorepo-builder": "^11.2.23"
    },
    "replace": {
        "hybridly/laravel": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Hybridly\\": [
                "packages/laravel/src"
            ],
            "Hybridly\\Tests\\": "packages/laravel/tests"
        },
        "files": [
            "packages/laravel/src/Support/global_helpers.php",
            "packages/laravel/src/Support/helpers.php",
            "packages/laravel/src/Testing/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Build\\": [
                "build"
            ],
            "Hybridly\\Tests\\": "packages/laravel/tests"
        },
        "files": [
            "packages/laravel/src/Testing/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "carthage-software/mago": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "aliases": {
                "Hybridly": "Hybridly\\Facades\\Hybridly"
            },
            "providers": [
                "Hybridly\\HybridlyServiceProvider"
            ]
        }
    },
    "scripts": {
        "monorepo:bump": "php -d\"error_reporting = E_ALL & ~E_DEPRECATED\" vendor/bin/monorepo-builder bump-interdependency",
        "monorepo:alias": "php -d\"error_reporting = E_ALL & ~E_DEPRECATED\" vendor/bin/monorepo-builder package-alias",
        "monorepo:merge": "php -d\"error_reporting = E_ALL & ~E_DEPRECATED\" vendor/bin/monorepo-builder merge",
        "monorepo:validate": "php -d\"error_reporting = E_ALL & ~E_DEPRECATED\" vendor/bin/monorepo-builder validate",
        "test": "pest --test-directory=packages/laravel/tests",
        "fmt": "mago fmt",
        "qa": [
            "@monorepo:validate",
            "@fmt",
            "@test"
        ]
    }
}
