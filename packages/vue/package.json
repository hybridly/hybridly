{
  "name": "@hybridly/vue",
  "type": "module",
  "version": "0.8.0",
  "description": "Vue adapter for Hybridly",
  "author": "Enzo Innocenzi <enzo@innocenzi.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/innocenzi",
  "homepage": "https://github.com/hybridly/hybridly/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hybridly/hybridly.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/hybridly/hybridly/issues"
  },
  "keywords": [
    "hybridly",
    "inertiajs",
    "vue",
    "vue-plugin"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub"
  },
  "peerDependencies": {
    "vue": "^3.2.45"
  },
  "dependencies": {
    "@clickbar/dot-diver": "catalog:",
    "@hybridly/core": "workspace:*",
    "@hybridly/utils": "workspace:*",
    "@vue/devtools-api": "catalog:",
    "defu": "catalog:",
    "lodash.isequal": "catalog:",
    "nprogress": "catalog:",
    "qs": "catalog:"
  },
  "devDependencies": {
    "@types/lodash": "catalog:",
    "@types/lodash.isequal": "catalog:",
    "@types/nprogress": "catalog:",
    "@vue/test-utils": "catalog:",
    "axios": "catalog:",
    "vue": "catalog:"
  }
}
