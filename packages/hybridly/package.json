{
  "name": "hybridly",
  "type": "module",
  "version": "0.10.0-beta.4",
  "description": "Solution to develop server-driven, client-rendered applications",
  "author": "Enzo Innocenzi <enzo@innocenzi.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/innocenzi",
  "homepage": "https://github.com/hybridly/hybridly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hybridly/hybridly.git"
  },
  "bugs": {
    "url": "https://github.com/hybridly/hybridly/issues"
  },
  "keywords": [
    "hybridly",
    "inertiajs"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "files": [
    "*.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "build:stub": "obuild --stub"
  },
  "dependencies": {
    "@hybridly/core": "workspace:*",
    "@hybridly/vite": "workspace:*",
    "@hybridly/vue": "workspace:*"
  }
}
