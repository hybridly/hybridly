{
	"type": "module",
	"version": "0.9.0",
	"private": true,
	"packageManager": "bun@1.3.0",
	"scripts": {
		"release": "bumpp package.json packages/*/package.json --all --execute \"tsx build/bump-php-packages.ts\" --commit \"release: v\"",
		"build": "bun run --filter '*' build",
		"build:stub": "bun run --filter '*' build:stub",
		"test": "vitest --run",
		"test:all": "bun run test && composer test",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:serve": "vitepress serve docs",
		"ci": "bun run build && bun run test"
	},
	"devDependencies": {
		"@fontsource-variable/rubik": "^5.2.8",
		"@hybridly/core": "workspace:*",
		"@hybridly/utils": "workspace:*",
		"@hybridly/vite": "workspace:*",
		"@hybridly/vue": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@types/debug": "catalog:",
		"@types/node": "catalog:",
		"@types/qs": "catalog:",
		"@types/throttle-debounce": "catalog:",
		"@vitest/ui": "catalog:",
		"axios": "catalog:",
		"bumpp": "catalog:",
		"happy-dom": "catalog:",
		"hybridly": "workspace:*",
		"msw": "catalog:",
		"obuild": "^0.4.14",
		"tailwindcss": "^4.1.18",
		"tsx": "catalog:",
		"type-fest": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitepress": "https://pkg.pr.new/vitepress@f8d8c0d",
		"vitest": "catalog:",
		"vue": "catalog:"
	},
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@clickbar/dot-diver": "^1.0.7",
			"@fontsource-variable/rubik": "^5.2.6",
			"@iconify/json": "^2.2.348",
			"@types/debug": "^4.1.12",
			"@types/lodash": "^4.17.17",
			"@types/lodash.clonedeep": "^4.5.9",
			"@types/lodash.isequal": "^4.5.8",
			"@types/node": "^25.0.9",
			"@types/nprogress": "^0.2.3",
			"@types/qs": "^6.14.0",
			"@types/throttle-debounce": "^5.0.2",
			"@vitejs/plugin-vue": "^5.2.4",
			"@vitest/ui": "^4.0.17",
			"@vue/devtools-api": "^7.7.6",
			"@vue/test-utils": "^2.4.6",
			"axios": "^1.10.0",
			"bumpp": "^10.4.0",
			"debug": "^4.4.1",
			"deepmerge": "^4.3.1",
			"defu": "^6.1.4",
			"fast-glob": "^3.3.3",
			"happy-dom": "^20.3.1",
			"is-plain-object": "^5.0.0",
			"local-pkg": "^1.1.1",
