{
  "type": "module",
  "version": "0.8.1",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "release": "bumpp package.json packages/*/package.json --all --execute \"tsx build/bump-php-packages.ts\" --commit \"release: v\"",
    "build": "pnpm -r build",
    "test": "vitest --run",
    "test:all": "pnpm run test && composer test",
    "lint": "eslint \"**/*.{ts,vue,mjs}\"",
    "lint:fix": "eslint \"**/*.{ts,vue,mjs}\" --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "ci": "pnpm run lint && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@fontsource-variable/rubik": "catalog:",
    "@hybridly/core": "workspace:*",
    "@hybridly/utils": "workspace:*",
    "@hybridly/vite": "workspace:*",
    "@hybridly/vue": "workspace:*",
    "@innocenzi/eslint-config": "catalog:",
    "@types/debug": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "@types/throttle-debounce": "catalog:",
    "@vitest/ui": "catalog:",
    "axios": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "hybridly": "workspace:*",
    "msw": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@vitest/ui": "0.34.6",
			"vite": "6.3.5",
      "vitest": "0.34.6"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "react",
        "react-dom",
        "@types/react"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
