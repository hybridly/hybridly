{
	"type": "module",
	"version": "0.10.0-beta.14",
	"private": true,
	"packageManager": "bun@1.3.10",
	"scripts": {
		"release": "bumpp package.json packages/*/package.json --all --execute \"bun run build/bump-php-packages.ts\" --commit \"release: v\"",
		"build": "bun run --filter '*' build",
		"build:stub": "bun run --filter '*' build:stub",
		"test": "vitest --run",
		"test:all": "bun run test && composer test",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:serve": "vitepress serve docs",
		"ci": "bun run build && bun run test"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/noto-serif": "^5.2.9",
		"@fontsource-variable/rubik": "^5.2.8",
		"@fontsource/ia-writer-quattro": "^5.2.5",
		"@hybridly/core": "workspace:*",
		"@hybridly/utils": "workspace:*",
		"@hybridly/vite": "workspace:*",
		"@hybridly/vue": "workspace:*",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.10",
		"@types/debug": "catalog:",
		"@types/node": "catalog:",
		"@types/qs": "catalog:",
		"@vitest/ui": "catalog:",
		"axios": "catalog:",
		"bumpp": "catalog:",
		"happy-dom": "catalog:",
		"hybridly": "workspace:*",
		"msw": "catalog:",
		"obuild": "^0.4.32",
		"tailwindcss": "^4.2.2",
		"type-fest": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitepress": "2.0.0-alpha.17",
		"vitepress-plugin-llms": "^1.11.1",
		"vitest": "catalog:",
		"vue": "catalog:"
	},
	"workspaces": {
		"packages": [
			"packages/hybridly",
			"packages/core",
			"packages/utils",
			"packages/vite",
			"packages/vue"
		],
		"catalog": {
			"@clickbar/dot-diver": "^1.0.7",
			"@fontsource-variable/rubik": "^5.2.6",
			"@iconify/json": "^2.2.451",
