			"axios": "^1.13.6",
			"bumpp": "^11.0.1",
			"debug": "^4.4.1",
			"deepmerge": "^4.3.1",
			"defu": "^6.1.4",
			"fast-glob": "^3.3.3",
			"happy-dom": "^20.8.4",
			"local-pkg": "^1.1.1",
			"magic-string": "^0.30.17",
